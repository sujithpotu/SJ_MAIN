# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# These are exposed to the client bundle (that's what EXPO_PUBLIC_ means),
# which is expected: the anon key is safe to ship as long as Row Level
# Security policies are enabled on every table.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
